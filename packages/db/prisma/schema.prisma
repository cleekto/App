// Cleekto — схема базы данных.
//
// Модели появляются с фазы 3 по документу docs/architecture/erd.md.
// На фазе 2 схема содержит только подключение и расширения PostgreSQL:
// первая миграция обязана доказать, что конвейер работает, а не заморозить
// доменные решения раньше, чем фаза 3 их примет.
//
// ПРАВИЛО 9: применённые миграции не редактируются. Прежде чем добавлять
// модели, перечитай erd.md §10 и §11 — три вещи добавлены в проект схемы
// «на вырост», и после первой миграции их правка запрещена.

datasource db {
  provider = "postgresql"

  // Через пулер соединений. Без него serverless + Prisma исчерпает пул
  // на первом же агентстве с десятью агентами (риск R-11, ADR-0001).
  url = env("DATABASE_URL")

  // Мимо пулера — нужно Prisma для миграций.
  directUrl = env("DIRECT_URL")

  // pg_trgm  — нечёткое сравнение адресов, дедупликация 4 уровня.
  // pgcrypto — gen_random_uuid() для первичных ключей.
  extensions = [pgcrypto, pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}
