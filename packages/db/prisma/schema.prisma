// kleekTo — схема базы данных.
//
// Источник: docs/architecture/erd.md.
// Фаза 3 — арендаторы, доступ, журнал. Фаза 4 — объекты, объявления,
// контакты собственников, индекс наблюдений и дедупликация.
//
// ПРАВИЛО 9: применённые миграции не редактируются. Изменение схемы — это
// всегда новая миграция, а не правка существующей.
//
// ПРАВИЛО 5: companyId продублирован почти везде, хотя часто выводится через
// team. Это осознанная денормализация: любой запрос фильтруется по companyId
// напрямую, без join. Забытый join — утечка между арендаторами; забытый
// `where companyId` виден в коде глазами.

datasource db {
  provider = "postgresql"

  // Через пулер соединений. Без него serverless + Prisma исчерпает пул
  // на первом же агентстве с десятью агентами (риск R-11, ADR-0001).
  url = env("DATABASE_URL")

  // Мимо пулера — нужно Prisma для миграций.
  directUrl = env("DIRECT_URL")

  // pg_trgm  — нечёткое сравнение адресов, дедупликация 4 уровня (фаза 4).
  // pgcrypto — gen_random_uuid() для первичных ключей.
  extensions = [pgcrypto, pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ─────────────────────────────────────────────────────────────────────────────
// Арендаторы
// ─────────────────────────────────────────────────────────────────────────────

/// Граница арендатора. Жёсткая: данные двух компаний не сравниваются
/// и не показываются ни при какой проверке (инвариант 9).
model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  /// Язык по умолчанию для новых пользователей: ka | en | ru (ADR-0008).
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams            Team[]
  users            User[]
  teamMembers      TeamMember[]
  pipelineStatuses PipelineStatus[]
  activityLog      ActivityLog[]
  ownerContacts    OwnerContact[]
  propertyLinks    PropertyLink[]
  properties       Property[]
  publications     Publication[]
  migrationBatches MigrationBatch[]
  mappingSchemas   ColumnMappingSchema[]
  tasks            Task[]
  comments         Comment[]

  @@map("companies")
}

/// Команда — область дедупликации при создании объекта и область видимости
/// агента (решение владельца 2026-08-31, ADR-0006).
model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members    TeamMember[]
  properties Property[]
  tasks      Task[]
  comments   Comment[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("teams")
}

// ─────────────────────────────────────────────────────────────────────────────
// Доступ
// ─────────────────────────────────────────────────────────────────────────────

/// Три роли, справочник создаётся сидом (Q28, C-09).
/// Кастомных ролей в MVP нет, но таблица — а не перечисление в коде —
/// позволит добавить их без миграции живой базы агентства.
enum RoleCode {
  ADMIN
  MANAGER
  AGENT
}

model Role {
  id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code RoleCode @unique
  name String

  users User[]

  @@map("roles")
}

model User {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String @db.Uuid
  roleId       String @db.Uuid
  email        String
  passwordHash String
  fullName     String

  /// Рабочий телефон сотрудника — тот, что уходит в объявление.
  ///
  /// Агент публикует под своим именем и своим номером (решение владельца
  /// 2026-09-03), поэтому номер лежит здесь, а не в отдельной сущности.
  /// Пуст — сотрудник ещё не может публиковать: выдумывать номер за него
  /// нельзя (правило 14).
  phone String?
  /// E.164. Нужен не для показа, а для сравнения: по нему объявление
  /// агентства опознаётся как своё, а номер исключается из дедупликации.
  phoneNormalized String?

  /// Язык интерфейса. Живёт на пользователе, а не на компании: в тбилисском
  /// агентстве работают люди с разными родными языками (ADR-0008).
  locale String @default("en")

  /// Пользователь не удаляется, а отключается: за ним числятся записи
  /// журнала, и физическое удаление разрушило бы историю.
  isActive Boolean @default(true)

  /// Счётчик для отзыва refresh-токенов. Растёт при смене пароля
  /// и при отключении пользователя (ADR-0003).
  tokenVersion Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role            Role             @relation(fields: [roleId], references: [id])
  teamMemberships TeamMember[]
  refreshTokens   RefreshToken[]
  activityLog     ActivityLog[]
  assignedTasks   Task[]           @relation("TaskAssignee")
  comments        Comment[]        @relation("CommentAuthor")

  /// Email уникален внутри компании, а не глобально: один человек может
  /// работать в двух агентствах, и запрет на это был бы нашей выдумкой.
  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  /// Поиск «этот номер — наш» при импорте: по нему объявление агентства
  /// опознаётся как своё, а номер не попадает в признаки дедупликации.
  @@index([companyId, phoneNormalized])
  @@map("users")
}

/// Членство в команде.
///
/// Отдельная таблица, а не поле `User.teamId`, — так требует промпт §3.Ф3.
/// В MVP действует ограничение «одна команда на пользователя»: область
/// дедупликации — команда, и при двух командах у одного агента было бы
/// непонятно, чья команда владеет созданным объектом.
///
/// Ограничение снимается изменением одного уникального индекса, когда
/// владелец решит иначе, — и это дешевле, чем добавлять таблицу в живую базу.
model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Одна команда на пользователя — ограничение MVP, см. комментарий выше.
  @@unique([userId])
  @@unique([teamId, userId])
  @@index([companyId])
  @@index([teamId])
  @@map("team_members")
}

/// Refresh-токены с ротацией. Хранится хеш, а не сам токен: утечка базы
/// не должна давать доступ к живым сессиям.
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  /// Отозван при ротации или при выходе.
  revokedAt    DateTime?
  /// Токен, выданный взамен этого. Повторное использование отозванного
  /// токена — признак кражи, и по цепочке видно, что произошло.
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Воронка и журнал
// ─────────────────────────────────────────────────────────────────────────────

/// Инвариант 4: статусы воронки не захардкожены.
/// Сид создаёт пять статусов на компанию (промпт §5Б.4).
model PipelineStatus {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String  @db.Uuid
  code       String
  name       String
  /// Переименован агентством.
  ///
  /// Имя статуса, созданного сидом, на экране не показывается: оно
  /// английское, а показывается перевод по коду — иначе грузинский агент
  /// видел бы «In base» посреди грузинского интерфейса. Но как только
  /// агентство назвало стадию по-своему, побеждать обязано его имя,
  /// иначе переименование просто не видно на экране.
  nameIsCustom Boolean @default(false)
  sortOrder  Int
  /// IN_BASE и IN_PROGRESS защищены от удаления: на них завязаны переходы,
  /// а не только отображение.
  isSystem   Boolean @default(false)
  colorToken String?

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([companyId, code])
  @@index([companyId, sortOrder])
  @@map("pipeline_statuses")
}

/// Инвариант 7: пишется при каждом значимом действии, с первого дня.
/// Фундамент KPI, аналитики и будущей геймификации.
///
/// ПРАВИЛО 10: персональных данных в before/after нет. Смена телефона
/// собственника пишется как факт изменения с маской, а не со значением.
model ActivityLog {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String  @db.Uuid
  teamId     String? @db.Uuid
  /// Пусто, если действие выполнила система, а не человек.
  userId     String? @db.Uuid
  entityType String
  entityId   String? @db.Uuid

  /// Строка, а не перечисление: набор действий растёт с каждой фазой,
  /// и enum потребовал бы миграции ради каждой новой записи.
  /// Значения — константы в packages/core, они же проверяются тестом.
  action String

  /// Заполняются для смены статуса и переназначения агента (Q30).
  /// Снимок объекта на каждое действие дал бы таблицу больше всей базы.
  before Json?
  after  Json?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, entityType, entityId])
  @@index([companyId, userId, createdAt(sort: Desc)])
  @@map("activity_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// Публикация
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Объекты и объявления (фаза 4)
// ─────────────────────────────────────────────────────────────────────────────

enum Source {
  SS_GE
  MYHOME_GE
}

enum TransactionType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
}

/// Как объект попал в базу. Правило R14 разрешает ровно два исключения
/// из «только по согласию», и оба обязаны быть видимы в карточке.
enum PropertyOrigin {
  /// Обычный путь: агент поговорил с собственником и получил согласие.
  consent
  /// Создан руками в вебе (Q29).
  manual
  /// Перенесён из файла агентства, фаза 4В.
  legacy_import
}

/// Живёт ли объявление на площадке. Меняет человек: фонового опроса
/// площадок нет и не будет (Q32, правило R11).
enum ListingLifecycle {
  active
  stale
  removed
}

/// Состояние работы над объявлением. Живёт на объявлении, а не на объекте
/// (инвариант 15): до согласия объекта не существует.
enum ObservationStateValue {
  new
  skipped
  refused
  no_answer
  callback
  converted
}

/// Связка записей об одной физической квартире, заведённых разными командами.
///
/// После перевода дедупликации на область команды две команды одного
/// агентства могут легально вести одну квартиру. Компании при этом нужно
/// знать, что это одна квартира: без связки не работают защита от
/// самоимпорта, предупреждение «объект уже размещён» и отчётность.
///
/// СВЯЗКА НЕ ДАЁТ ПРАВ. Агент чужой команды видит мягкую пометку, но не
/// телефон и не описание (Q40). Смешать группировку с доступом — прямое
/// нарушение правила 6.
model PropertyLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @db.Uuid
  createdAt DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([companyId])
  @@map("property_links")
}

/// Контакт собственника.
///
/// ПРАВИЛО 10: имя и телефоны не логируются, не попадают в фикстуры
/// в исходном виде и не уходят на площадку при публикации (правило 13).
model OwnerContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @db.Uuid
  fullName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phones     OwnerContactPhone[]
  properties Property[]

  @@index([companyId])
  @@map("owner_contacts")
}

/// Телефоны собственника отдельной таблицей, а не полями phone1 и phone2.
///
/// В объявлении регулярно два номера, а телефон — ключ дедупликации уровней
/// 2 и 3, то есть по нему идёт ПОИСК. Два поля означали бы либо поиск по двум
/// колонкам, либо потерю признака.
model OwnerContactPhone {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerContactId String @db.Uuid
  companyId      String @db.Uuid

  /// Как на странице. Без оригинала разобраться в неверной нормализации
  /// невозможно, а она ломает дедупликацию молча (риск R-06).
  phoneOriginal   String
  /// E.164. По нему идёт сравнение.
  phoneNormalized String

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  ownerContact OwnerContact @relation(fields: [ownerContactId], references: [id], onDelete: Cascade)

  /// ГЛАВНЫЙ ИНДЕКС ПРОДУКТА: дедупликация уровней 2 и 3.
  @@index([companyId, phoneNormalized])
  @@index([ownerContactId])
  @@map("owner_contact_phones")
}

/// Физическая квартира. Существует независимо от того, рекламируется ли она
/// сейчас хоть где-нибудь (инвариант 5).
model Property {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @db.Uuid

  /// Владение — команда (Q33). Она же область проверки на дубли при «Согласен».
  teamId         String  @db.Uuid
  assignedUserId String? @db.Uuid
  propertyLinkId String? @db.Uuid

  pipelineStatusId String @db.Uuid

  /// ОБЯЗАТЕЛЬНОЕ и неизменяемое через API. Необязательное поле через год
  /// было бы наполовину пустым, и никто не сказал бы, был ли разговор
  /// с собственником (J15, инвариант 14).
  origin   PropertyOrigin
  originAt DateTime       @default(now())

  /// Заполнено только при origin = legacy_import. Без обратной ссылки отмена
  /// импорта превращается в поиск по дате создания — то есть в угадывание.
  migrationBatchId String? @db.Uuid

  ownerContactId String? @db.Uuid

  transactionType TransactionType
  propertyType    PropertyType

  rooms       Int?
  areaTotal   Decimal? @db.Decimal(10, 2)
  floor       Int?
  totalFloors Int?

  district          String?
  /// Как на площадке.
  addressRaw        String?
  /// Приведённый вид для сравнения. Отдельным полем, потому что индекс
  /// по триграммам строится только по хранимой колонке.
  addressNormalized String?

  price    Decimal? @db.Decimal(14, 2)
  currency String?  @db.Char(3)

  /// Описание из объявления — чужой текст.
  descriptionSource String?
  /// Текст для публикации, редактируется в CRM. Публиковать чужое описание
  /// от своего имени странно и юридически, и стилистически (P1).
  publicDescription String?

  /// Только URL: файлы в MVP не хранятся (Q11). Последствие — риск R-07
  /// и невозможность автоподстановки фото в форму размещения (P3).
  photos String[]

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pipelineStatus PipelineStatus  @relation(fields: [pipelineStatusId], references: [id])
  ownerContact   OwnerContact?   @relation(fields: [ownerContactId], references: [id], onDelete: SetNull)
  propertyLink   PropertyLink?   @relation(fields: [propertyLinkId], references: [id], onDelete: SetNull)
  migrationBatch MigrationBatch? @relation(fields: [migrationBatchId], references: [id], onDelete: SetNull)

  sourceListings    SourceListing[]
  observationStates ObservationState[]
  publications      Publication[]
  tasks             Task[]
  comments          Comment[]

  @@index([companyId, teamId, pipelineStatusId])
  @@index([companyId, teamId, updatedAt(sort: Desc)])
  @@index([companyId, propertyLinkId])
  @@index([companyId, teamId, ownerContactId])
  /// Отдельный фильтр «архив агентства» в списке объектов (L15, риск R-34).
  @@index([companyId, origin])
  @@index([migrationBatchId])
  /// Дедупликация 4 уровня: нечёткое сравнение адресов. Индекс по триграммам
  /// строится только по хранимой колонке — поэтому addressNormalized
  /// отдельное поле, а не вычисление на лету.
  @@index([addressNormalized(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("properties")
}

/// Объявление об объекте на конкретной площадке.
///
/// Отделено от Property (инвариант 5). Без этого разделения дедупликация
/// невозможна в принципе: собственник размещает одну квартиру на обеих
/// площадках, и два импорта дали бы два одинаково настоящих объекта.
model SourceListing {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String @db.Uuid
  companyId  String @db.Uuid

  /// Денормализован ради частичных уникальных индексов идемпотентности:
  /// ключ — на команде, а не на компании (Q43).
  teamId String @db.Uuid

  source       Source
  /// МОЖЕТ ОТСУТСТВОВАТЬ у площадки в принципе (риск R-08). Уровни 2–4
  /// обязаны работать без него.
  externalId   String?
  /// Запасной ключ, когда externalId нет. Канонизируется до сравнения.
  canonicalUrl String
  /// Как агент открыл страницу, со всеми метками.
  originalUrl  String

  price    Decimal? @db.Decimal(14, 2)
  currency String?  @db.Char(3)

  lifecycle ListingLifecycle @default(active)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// Версия чтения, отдельная от formVersion: разметка страницы объявления
  /// и форма размещения ломаются независимо (инвариант 6).
  parserVersion String
  /// Что извлечь не удалось — честно, а не молча (D9).
  missingFields String[]

  importedByUserId String?  @db.Uuid
  importedAt       DateTime @default(now())

  property     Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  priceHistory SourceListingPriceHistory[]

  /// Идемпотентность, уровень 1 дедупликации. Два ЧАСТИЧНЫХ индекса, а не
  /// один составной: NULL в Postgres не конфликтует сам с собой, и обычный
  /// уникальный индекс по externalId пропустил бы сколько угодно записей
  /// с пустым идентификатором.
  @@unique([teamId, source, externalId])
  @@unique([teamId, source, canonicalUrl])
  @@index([propertyId])
  @@index([companyId, canonicalUrl])
  @@map("source_listings")
}

/// История цены объявления.
///
/// При повторном импорте цена уже сравнивается (Q21) — записать изменение
/// стоит одну вставку. Даёт агенту аргумент в разговоре с собственником.
model SourceListingPriceHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceListingId String   @db.Uuid
  price           Decimal  @db.Decimal(14, 2)
  currency        String   @db.Char(3)
  changedAt       DateTime @default(now())

  sourceListing SourceListing @relation(fields: [sourceListingId], references: [id], onDelete: Cascade)

  @@index([sourceListingId, changedAt(sort: Desc)])
  @@map("source_listing_price_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// Индекс объявлений
// ─────────────────────────────────────────────────────────────────────────────

/// ЕДИНСТВЕННАЯ ТАБЛИЦА БЕЗ companyId, и это не упущение, а инвариант 16.
///
/// Индекс общий для всех компаний, включая контакты: в нём только то, что
/// площадка отдаёт любому посетителю по клику. Решение владельца (Q37).
///
/// ОПАСНОСТЬ, которую это создаёт: во всех остальных таблицах отсутствие
/// companyId означает утечку между арендаторами. Разработчик, увидевший эту
/// модель, может решить, что так можно и в других местах. Негативный тест
/// на изоляцию проверяет её ОТДЕЛЬНО от прочих.
model ListingObservation {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source       Source
  externalId   String?
  canonicalUrl String

  price    Decimal? @db.Decimal(14, 2)
  currency String?  @db.Char(3)

  area        Decimal? @db.Decimal(10, 2)
  rooms       Int?
  floor       Int?
  totalFloors Int?

  district        String?
  propertyType    PropertyType?
  transactionType TransactionType?

  ownerName       String?
  ownerPhone      String?
  phoneNormalized String?

  /// Догадка «телефон встречается у многих объявлений», а не факт:
  /// разметки «агентство» площадка не даёт. Нужна отсеву ленты (K10).
  isAgencyGuess Boolean @default(false)

  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  lastPriceChangeAt DateTime?

  states       ObservationState[]
  priceHistory ObservationPriceHistory[]

  @@unique([source, externalId])
  @@unique([source, canonicalUrl])
  @@index([district, rooms, area])
  @@index([phoneNormalized])
  @@map("listing_observations")
}

/// История цены наблюдения — ключевая ценность индекса (K8).
///
/// Отдельная таблица, а не массив в jsonb: по ней идут запросы «цена
/// снижалась N раз» и «висит N дней», а по jsonb это не индексируется.
/// Накопление начинается при первой технической возможности: задним числом
/// историю не получить.
model ObservationPriceHistory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  observationId String   @db.Uuid
  price         Decimal  @db.Decimal(14, 2)
  currency      String   @db.Char(3)
  observedAt    DateTime @default(now())

  observation ListingObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId, observedAt(sort: Desc)])
  @@map("observation_price_history")
}

/// Состояние работы над объявлением — НА КОМАНДУ (инвариант 17).
///
/// Индекс общий, но «кто позвонил, кто отказал, что уже в работе» — рабочие
/// данные агентства. В общем слое они дали бы одному агентству видимость
/// активности другого.
model ObservationState {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  observationId String @db.Uuid
  companyId     String @db.Uuid
  teamId        String @db.Uuid

  state ObservationStateValue @default(new)

  callbackAt DateTime?
  note       String?

  /// Не седьмое состояние, а флаг при refused (Q40а, §5Б.3). Обычный отказ
  /// действует на команду — другая может попробовать, конкуренция разрешена.
  /// «Просил не звонить» действует на всю компанию и не сбрасывается
  /// изменением цены: это просьба собственника, а не результат переговоров.
  doNotCallCompanyWide Boolean @default(false)

  /// Связь отработанного лида с созданным объектом. Нужна, чтобы уведомление
  /// о снижении цены пришло на карточку объекта, а не в ленту (K24).
  convertedPropertyId String? @db.Uuid

  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  observation       ListingObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  convertedProperty Property?          @relation(fields: [convertedPropertyId], references: [id], onDelete: SetNull)

  /// Одно состояние на пару «объявление × команда».
  @@unique([observationId, teamId])
  @@index([companyId, teamId, state])
  @@map("observation_states")
}

// ─────────────────────────────────────────────────────────────────────────────
// Публикация (фаза 4Б)
// ─────────────────────────────────────────────────────────────────────────────

/// Жизненный цикл публикации.
///
/// `published` ставится ТОЛЬКО по подтверждению агента (инвариант 13):
/// расширение не знает, нажал ли он «Опубликовать» — форму отправляет
/// площадка. Отсюда же дыра в защите от самоимпорта, закрываемая
/// запасными признаками (Q31, §5.5).
enum PublicationStatus {
  /// Черновик собран на сервере, форма ещё не заполнялась.
  draft
  /// Форма заполнена расширением. Отправил ли её агент — неизвестно.
  filled
  /// Агент подтвердил, что объявление размещено. Есть externalUrl.
  published
  /// Объявление снято с площадки. Ставит человек: фонового опроса нет (Q32).
  expired
}

/// Публикация объекта на площадке.
///
/// СТАТУС ПУБЛИКАЦИИ И СТАТУС ВОРОНКИ — РАЗНЫЕ ВЕЩИ, и смешивать их нельзя
/// (J13, J14). Объект переходит в «Принято в работу» по факту ЗАПОЛНЕНИЯ
/// формы, потому что расширение не знает о нажатии «Опубликовать».
/// Статус воронки отражает работу агента, `Publication` — факт на площадке:
/// первое нужно воронке, второе — защите от самоимпорта.
model Publication {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @db.Uuid
  teamId    String @db.Uuid

  propertyId String @db.Uuid

  /// Имя и телефон, под которыми объявление ушло на площадку.
  ///
  /// Хранятся здесь, а не берутся из сотрудника при показе: это запись
  /// о том, что реально стоит в чужом объявлении. Сотрудник потом сменит
  /// номер, а в объявлении на площадке останется прежний, и история
  /// публикаций обязана показывать его, а не текущий.
  publisherName  String?
  publisherPhone String?

  source Source
  status PublicationStatus @default(draft)

  /// Версия заполнения формы. ОТДЕЛЬНАЯ от parserVersion: разметка страницы
  /// объявления и форма размещения ломаются независимо (инвариант 6, I9).
  formVersion String?

  /// Появляются только после подтверждения агентом.
  externalId  String?
  externalUrl String?

  /// Что заполнить не удалось и почему: no_value, no_mapping,
  /// field_not_found, manual_only. Частичное заполнение — штатный режим
  /// (правило 14), поэтому список пустым не бывает почти никогда.
  unfilledFields Json?

  filledAt          DateTime?
  publishedAt       DateTime?
  confirmedByUserId String?   @db.Uuid

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([companyId, propertyId])
  /// Защита от самоимпорта, пункт 1: сравнение source + externalId
  /// с публикациями компании (§5.5).
  @@index([companyId, source, externalId])
  /// Пункт 2: сравнение канонического адреса с записями в статусе filled —
  /// работает даже без подтверждения агента (Q31).
  @@index([companyId, externalUrl])
  @@map("publications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Миграция базы агентства (фаза 4В)
// ─────────────────────────────────────────────────────────────────────────────

/// Сохранённое сопоставление «колонка файла → поле системы» (L4).
///
/// Второй файл того же агентства ложится на готовую схему. Реальные выгрузки
/// делают из одной и той же таблицы, и заставлять сопоставлять заново каждый
/// раз — верный способ, чтобы агентство бросило миграцию на середине.
model ColumnMappingSchema {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @db.Uuid
  name      String

  /// { "Цена $": "price", "ფართობი": "area", "тел": "ownerPhone" }
  /// Колонки, помеченные пропуском, тоже хранятся: молча выброшенная
  /// колонка — та, про которую потом будут спорить, была ли она в файле.
  mapping Json

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches MigrationBatch[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("column_mapping_schemas")
}

enum MigrationBatchStatus {
  /// Файл загружен, колонки определены, сопоставления ещё нет.
  draft
  /// Сопоставление задано, предпросмотр доступен. В базу ничего не записано.
  previewed
  /// Объекты созданы.
  applied
  /// Импорт отменён целиком.
  rolled_back
}

/// Один заход миграции.
///
/// Существует ради двух вещей, которые без него не работают: отмены целиком
/// одной операцией (L9) и отчёта о том, что именно было отклонено и почему.
model MigrationBatch {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @db.Uuid
  /// Команда, которой достанутся перенесённые объекты: владение — команда.
  teamId    String @db.Uuid

  fileName        String
  mappingSchemaId String? @db.Uuid

  status MigrationBatchStatus @default(draft)

  /// Заголовки колонок как они есть в файле, включая пустые и дублирующиеся.
  detectedColumns String[]
  /// Разобранные строки файла. Хранятся до применения, чтобы предпросмотр
  /// и запись работали с одними и теми же данными, а не перечитывали файл.
  rawRows         Json?

  totalRows    Int  @default(0)
  acceptedRows Int?
  rejectedRows Int?

  /// Причины отклонения по номерам строк. ПЕРСОНАЛЬНЫХ ДАННЫХ НЕТ
  /// (правило 10): строка описывается номером и кодом причины,
  /// а не содержимым.
  report Json?

  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  appliedAt       DateTime?
  rolledBackAt    DateTime?

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mappingSchema ColumnMappingSchema? @relation(fields: [mappingSchemaId], references: [id], onDelete: SetNull)
  properties    Property[]

  @@index([companyId, createdAt(sort: Desc)])
  @@map("migration_batches")
}

/// Состояние задачи.
///
/// Три значения, а не пять: DESIGN §20 требует, чтобы задачи ощущались
/// лёгкими, и прямо предупреждает не превращать их в систему управления
/// проектами. Отменённая задача отличается от выполненной тем, что работу
/// по ней не сделали, — для отчётности это разные вещи.
enum TaskStatus {
  open
  done
  cancelled
}

/// Задача агента, привязанная к объекту.
///
/// Отдельной сущностью, а не полем в `Property`: у объекта их несколько,
/// и у каждой свой исполнитель и срок. Задача без объекта не создаётся —
/// в CRM агентства задача «просто так» не имеет смысла и превращает список
/// в свалку.
model Task {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @db.Uuid

  /// Команда владельца объекта. Дублируется сюда сознательно: без неё
  /// «мои задачи» и «задачи команды» требовали бы join с объектом
  /// на каждый запрос списка.
  teamId     String @db.Uuid
  propertyId String @db.Uuid

  title       String
  description String?

  /// Может быть не назначен: агент ставит себе напоминание, ещё не решив,
  /// кто именно будет звонить.
  assignedUserId String?   @db.Uuid
  dueAt          DateTime?

  status TaskStatus @default(open)

  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignee User?    @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([companyId, propertyId, createdAt(sort: Desc)])
  /// «Мои задачи с ближайшим сроком» — главный список агента.
  @@index([companyId, assignedUserId, status, dueAt])
  @@index([companyId, teamId, status, dueAt])
  @@map("tasks")
}

/// Комментарий к объекту.
///
/// Текст пишет сотрудник агентства, а не площадка, — но он всё равно
/// отображается как чужой ввод и не исполняется как разметка.
model Comment {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @db.Uuid

  teamId     String @db.Uuid
  propertyId String @db.Uuid

  body String

  /// Автор может быть удалён из компании — комментарий остаётся, потому что
  /// это часть истории объекта. Показывается как «бывший сотрудник».
  authorUserId String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author   User?    @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, propertyId, createdAt(sort: Desc)])
  @@map("comments")
}

/// Счётчик обращений для ограничения частоты запросов.
///
/// В БАЗЕ, А НЕ В ПАМЯТИ ПРОЦЕССА. Веб работает на serverless: экземпляров
/// много, они поднимаются и гаснут, и счётчик в памяти означал бы, что предел
/// умножается на число экземпляров, а после каждого простоя обнуляется.
/// Защита от подбора пароля, работающая «примерно», не защищает.
///
/// Ключ не содержит персональных данных: адрес почты хешируется, IP хранится
/// как есть только на время окна (правило 10).
model RateLimit {
  /// `scope:hash` — что ограничиваем и для кого.
  key         String   @id
  /// Начало текущего окна. Старые строки чистятся по нему.
  windowStart DateTime
  hits        Int      @default(0)

  @@index([windowStart])
  @@map("rate_limits")
}
