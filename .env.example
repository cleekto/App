# ─────────────────────────────────────────────────────────────────────────────
# Cleekto — пример окружения.
#
# Скопируй в .env и заполни. Файл .env в git не попадает никогда (правило 8).
# Каждая переменная ниже описана: переменная без объяснения — это переменная,
# которую через полгода никто не решится удалить.
# ─────────────────────────────────────────────────────────────────────────────

# ── База данных ──────────────────────────────────────────────────────────────

# Строка подключения к PostgreSQL.
# Значение ниже соответствует docker-compose.yml и работает сразу после `pnpm db:up`.
DATABASE_URL="postgresql://cleekto:cleekto_local_dev@localhost:5432/cleekto?schema=public"

# Прямое подключение в обход пулера — нужно Prisma для миграций.
# Локально совпадает с DATABASE_URL. В проде обязано отличаться:
# DATABASE_URL идёт через пулер соединений, DIRECT_URL — мимо него.
# Без пулера serverless + Prisma исчерпает пул соединений на первом же
# агентстве с десятью агентами (риск R-11, ADR-0001 оговорка 2).
DIRECT_URL="postgresql://cleekto:cleekto_local_dev@localhost:5432/cleekto?schema=public"

# ── Аутентификация (ADR-0003) ────────────────────────────────────────────────

# Секрет подписи access-токенов. Минимум 32 байта случайных данных.
# Сгенерировать: openssl rand -base64 48
# Смена секрета инвалидирует все активные сессии — это штатный способ
# аварийного отзыва доступа.
AUTH_JWT_SECRET="замени_меня_на_случайную_строку_минимум_32_байта"

# Срок жизни access-токена в секундах.
# 900 = 15 минут. Это же окно, в течение которого изменение роли,
# команды или отключение пользователя ещё не вступили в силу (ADR-0003).
# Уменьшение ускоряет отзыв прав ценой более частого обновления.
AUTH_ACCESS_TTL_SECONDS="900"

# Срок жизни refresh-токена в секундах. 2592000 = 30 дней.
AUTH_REFRESH_TTL_SECONDS="2592000"

# ── Приложение ───────────────────────────────────────────────────────────────

# Базовый адрес веб-приложения. Расширение обращается к API по нему же.
APP_URL="http://localhost:3000"

# Язык интерфейса по умолчанию для новой компании: ka | en | ru.
# Английский нейтрален и не требует угадывать состав команды (ADR-0008).
# Пользователь переключает язык сам, настройка живёт на пользователе.
DEFAULT_LOCALE="en"

# NODE_ENV здесь намеренно НЕТ. Его выставляет сам инструмент:
# `next dev` — development, `next start` и сборка — production, vitest — test.
# Значение в файле окружения перекрыло бы это и сломало бы `next start`.
