{
  "name": "kleekto",
  "version": "0.1.0",
  "private": true,
  "description": "kleekTo — CRM для агентств недвижимости Грузии",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "db:down": "docker compose down",
    "db:generate": "node scripts/with-env.mjs --cwd packages/db prisma generate",
    "db:migrate": "node scripts/with-env.mjs --cwd packages/db prisma migrate dev",
    "db:migrate:deploy": "node scripts/with-env.mjs --cwd packages/db prisma migrate deploy",
    "db:seed": "node scripts/with-env.mjs --cwd packages/core tsx src/seed/cli.ts",
    "db:studio": "node scripts/with-env.mjs --cwd packages/db prisma studio",
    "db:up": "docker compose up -d",
    "dev": "node scripts/with-env.mjs --cwd apps/web next dev",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "start": "node scripts/with-env.mjs --cwd apps/web next start",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6"
  }
}
