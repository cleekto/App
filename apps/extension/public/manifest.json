{
  "manifest_version": 3,
  "name": "kleekTo",
  "version": "0.1.0",
  "description": "Real estate CRM for agencies",
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {},
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://home.ss.ge/*",
        "https://ss.ge/*",
        "https://www.myhome.ge/*",
        "https://myhome.ge/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["http://localhost:3000/*"]
}
